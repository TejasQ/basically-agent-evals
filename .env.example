# OpenRouter API key for LLM-as-judge calls
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Judge model to use (default: anthropic/claude-sonnet-4.6)
JUDGE_MODEL=anthropic/claude-sonnet-4.6

# OpenRAG server URL (for 02-rag and 03-console)
OPENRAG_URL=http://localhost:8000

# Set to "true" to run without network calls (uses canned responses)
MOCK_MODE=false
